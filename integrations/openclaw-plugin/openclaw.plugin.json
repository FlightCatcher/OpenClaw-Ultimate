{
  "id": "openclaw-ultimate",
  "name": "VELA for OpenClaw",
  "description": "Adds VELA planning, execution, reflection and local knowledge to OpenClaw.",
  "version": "1.0.4",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "ocu_plan",
      "ocu_knowledge"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectRoot": {
        "type": "string",
        "description": "Absolute path to the OpenClaw-Ultimate repository."
      },
      "uvCommand": {
        "type": "string",
        "default": "uv"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 1800000,
        "default": 600000
      }
    }
  },
  "uiHints": {
    "projectRoot": {
      "label": "VELA project root",
      "placeholder": "E:\\Projects\\OpenClaw-Ultimate"
    },
    "timeoutMs": {
      "label": "Execution timeout (ms)"
    }
  }
}
