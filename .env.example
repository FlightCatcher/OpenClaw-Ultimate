OCU_APP_NAME=VELA
OCU_LOG_LEVEL=INFO

OCU_OLLAMA_BASE_URL=http://127.0.0.1:11434
OCU_OLLAMA_MODEL=qwen3:8b
OCU_OLLAMA_API_KEY=

OCU_MODEL_TIMEOUT=300
OCU_TEMPERATURE=0.2
OCU_MAX_STEPS=8

OCU_ENABLE_SHELL_TOOL=false
OCU_WORKSPACE_ROOT=.
OCU_WORKSPACE_MAX_READ_BYTES=1000000
OCU_WORKSPACE_MAX_RESULTS=200
OCU_SHELL_ALLOWED_COMMANDS=["git","uv","python","pytest"]
OCU_SHELL_TIMEOUT=30
OCU_SHELL_MAX_OUTPUT_CHARACTERS=20000

OCU_SESSION_DB_PATH=.openclaw/sessions.db
OCU_HISTORY_MESSAGE_LIMIT=100

OCU_CONTEXT_TOKEN_BUDGET=8192
OCU_CONTEXT_RESPONSE_RESERVE=2048

OCU_MEMORY_ENABLED=true
OCU_MEMORY_DB_PATH=.openclaw/memory.db
OCU_EMBEDDING_MODEL=qwen3-embedding:0.6b
OCU_MEMORY_RECALL_LIMIT=5
OCU_MEMORY_SIMILARITY_THRESHOLD=0.35
OCU_MEMORY_MAX_CONTEXT_CHARACTERS=2000

OCU_PLANNER_DB_PATH=.openclaw/plans.db
OCU_PLANNER_MAX_STEPS=12
OCU_GOVERNANCE_DB_PATH=.openclaw/governance.db

# Existing local OpenClaw integration. Authentication remains in OpenClaw's
# own config; OCU never copies the Gateway token.
OCU_OPENCLAW_ENABLED=true
OCU_OPENCLAW_CLI_COMMAND=openclaw
OCU_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OCU_OPENCLAW_AGENT_ID=main
OCU_OPENCLAW_MODEL=ollama/qwen3:8b
OCU_OPENCLAW_TIMEOUT=600

# Local hardware-aware model routing. Keep one 4B-8B model resident at a
# time on the current RTX 3060 Ti 8GB workstation.
OCU_GPU_VRAM_GB=8
OCU_MODEL_RESIDENT_BUDGET_GB=6.5

# Reuse the existing OpenClaw ComfyUI profile by default. OCU reads only
# the configured base URL, workflow path and node mapping.
OCU_COMFYUI_ENABLED=true
OCU_COMFYUI_INHERIT_OPENCLAW_CONFIG=true
OCU_OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json

# MCP is allowlist-only. The checked-in local server exposes harmless,
# read-only workspace diagnostics and can be replaced with your own entries.
OCU_MCP_ENABLED=true
OCU_MCP_SERVERS_PATH=configs/mcp_servers.local.json
OCU_MCP_TIMEOUT=30

# Existing local OpenClaw knowledge library. The 1 MB default indexes the
# focused documents first and deliberately skips very large repository dumps.
OCU_KNOWLEDGE_ENABLED=true
OCU_KNOWLEDGE_ROOT=E:/OpenClaw-Knowledge/library
OCU_KNOWLEDGE_DB_PATH=.openclaw/knowledge.db
OCU_KNOWLEDGE_MAX_FILE_BYTES=1000000
OCU_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16

# Local JSON API. Remote binding is rejected unless explicitly enabled.
OCU_API_HOST=127.0.0.1
OCU_API_PORT=8765
OCU_API_ALLOW_REMOTE=false
OCU_API_MAX_BODY_BYTES=1000000

# Native local vision through Ollama. Image paths remain restricted to the
# configured workspace root.
OCU_VISION_ENABLED=true
OCU_VISION_MODEL=qwen3-vl:8b
OCU_VISION_MAX_FILE_BYTES=20000000

# Optional whisper.cpp-compatible CLI. Disabled until both values are set.
OCU_WHISPER_ENABLED=false
OCU_WHISPER_COMMAND=whisper-cli
OCU_WHISPER_MODEL_PATH=
